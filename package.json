{
  "name": "useless-evolution",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "废物进化论 — 物品苏醒、形态进化与动作演示",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts",
    "preview": "vite preview",
    "test:living": "tsx scripts/living-check.ts",
    "test:living-ui": "node scripts/living-qa.mjs",
    "test:exhibits": "tsx scripts/exhibits-check.ts",
    "test:exhibits-ui": "node scripts/multi-lux-qa.mjs",
    "test:workshop": "tsx scripts/workshop-check.ts && tsx scripts/workshop-api-check.ts",
    "test:workshop-ui": "node scripts/workshop-qa.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.1.0",
    "playwright-core": "^1.65.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
